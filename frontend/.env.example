# Local development environment variables.
# Copy to .env.local if you need to override anything. Never put secrets here:
# every VITE_* value is bundled into the public JavaScript.

# Base URL the frontend uses for API calls.
# "/" keeps requests same-origin and lets the Vite dev proxy forward them (recommended for development).
# Set an absolute URL such as "https://api.nepalhub.com/api" for a deployed API.
VITE_API_BASE_URL=/api

# Development-only: where the Vite dev proxy forwards /api and /health requests.
# This is never used by the browser and must never be exposed to production.
VITE_BACKEND_URL=http://localhost:5080
