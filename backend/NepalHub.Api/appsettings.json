{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ServerVersion": "8.4.0-mysql",
    "AutoMigrate": true
  },
  "Auth": {
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Logout": {
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Calculate": {
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Quiz": {
    "QuestionsPerQuiz": 10,
    "XpPerCorrectAnswer": 10,
    "CompletionBonusXp": 20,
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Report": {
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "Claim": {
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "Business": {
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "Booking": {
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 3600
    }
  },
  "Payment": {
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 3600
    }
  },
  "Payments": {
    "Provider": "none",
    "Environment": "sandbox",
    "ReconcileIntervalSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
